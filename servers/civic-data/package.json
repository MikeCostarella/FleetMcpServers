{
  "name": "@fleet-mcp/civic-data",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only MCP server over OhioCivicData (civic schema) via Microsoft Data API builder. Configuration only — no TypeScript; the engine is the `dab` .NET global tool.",
  "type": "module",
  "scripts": {
    "build": "node -e \"console.log('civic-data: config-only (DAB), nothing to build')\"",
    "test": "node -e \"JSON.parse(require('fs').readFileSync('dab-config.json','utf8')); console.log('civic-data: dab-config.json parses')\"",
    "validate": "dab validate --config dab-config.json",
    "start": "dab start --mcp-stdio role:reader --config dab-config.json",
    "start:http": "dab start --config dab-config.json"
  },
  "engines": {
    "node": ">=18"
  }
}
